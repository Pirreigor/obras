generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  // Sin empresaId: existe fuera de toda empresa, gestiona la plataforma.
  SUPERADMINISTRADOR
  ADMINISTRADOR
  SUPERVISOR
  RESIDENTE
  CALIDAD_PRODUCCION
}

enum EstadoObra {
  PLANIFICACION
  EN_PROGRESO
  PAUSADO
  FINALIZADO
  CANCELADO
}

enum EstadoSubObra {
  ACTIVA
  PAUSADA
  CERRADA
}

enum EstadoActividad {
  PENDIENTE
  EN_CURSO
  HECHA
}

enum EstadoPedido {
  SOLICITADO
  APROBADO
  COMPRADO_EN_CAMINO
  RECIBIDO
}

enum EstadoInvitacion {
  PENDIENTE
  ACEPTADA
  EXPIRADA
  REVOCADA
}

model Empresa {
  id     Int    @id @default(autoincrement())
  nombre String @unique

  usuarios            Usuario[]
  zonas               Zona[]
  actividadesCatalogo ActividadCatalogo[]
  materialesCatalogo  MaterialCatalogo[]
  invitaciones        Invitacion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("empresas")
}

model Usuario {
  id           Int      @id @default(autoincrement())
  // null solo para SUPERADMINISTRADOR; todo otro rol pertenece a una empresa.
  empresaId    Int?
  empresa      Empresa? @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  name         String
  email        String   @unique
  passwordHash String
  rol          Rol      @default(CALIDAD_PRODUCCION)

  obrasComoResidente      Obra[]             @relation("ObraResidente")
  subObrasComoResponsable SubObra[]          @relation("SubObraResponsableCalidad")
  subObrasComoResidente   SubObraResidente[]
  registrosDiarios        RegistroDiario[]   @relation("RegistroDiarioCreadoPor")
  avancesCreados          Avance[]           @relation("AvanceCreadoPor")
  pedidosCreados          PedidoMaterial[]   @relation("PedidoCreadoPor")
  invitacionesEnviadas    Invitacion[]       @relation("InvitacionInvitadoPor")
  vistasAsignadas         UsuarioVista[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("usuarios")
}

model Vista {
  id     Int    @id @default(autoincrement())
  // identificador estable usado por el codigo (ej. "equipo"); nombre es
  // solo la etiqueta que se muestra en el menu.
  clave  String @unique
  nombre String

  usuarios UsuarioVista[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("vistas")
}

model UsuarioVista {
  id        Int     @id @default(autoincrement())
  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  vistaId   Int
  vista     Vista   @relation(fields: [vistaId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([usuarioId, vistaId])
  @@map("usuario_vistas")
}

model Invitacion {
  id            Int              @id @default(autoincrement())
  empresaId     Int
  empresa       Empresa          @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  email         String
  // Restringido en la app a roles de empresa (nunca SUPERADMINISTRADOR).
  rol           Rol
  token         String           @unique
  estado        EstadoInvitacion @default(PENDIENTE)
  invitadoPorId Int?
  invitadoPor   Usuario?         @relation("InvitacionInvitadoPor", fields: [invitadoPorId], references: [id], onDelete: SetNull)
  expiresAt     DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("invitaciones")
}

model Zona {
  id        Int     @id @default(autoincrement())
  empresaId Int
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nombre    String

  localidades Localidad[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([empresaId, nombre])
  @@map("zonas")
}

model Localidad {
  id     Int    @id @default(autoincrement())
  zonaId Int
  zona   Zona   @relation(fields: [zonaId], references: [id], onDelete: Cascade)
  nombre String

  obras Obra[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("localidades")
}

model Obra {
  id               Int        @id @default(autoincrement())
  localidadId      Int
  localidad        Localidad  @relation(fields: [localidadId], references: [id], onDelete: Cascade)
  nombre           String
  descripcion      String?
  cliente          String?
  direccion        String?
  estado           EstadoObra @default(PLANIFICACION)
  presupuesto      Float?
  fechaInicio      DateTime?
  fechaFinEstimada DateTime?
  residenteId      Int?
  residente        Usuario?   @relation("ObraResidente", fields: [residenteId], references: [id], onDelete: SetNull)

  subObras SubObra[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("obras")
}

model SubObra {
  id                   Int           @id @default(autoincrement())
  obraId               Int
  obra                 Obra          @relation(fields: [obraId], references: [id], onDelete: Cascade)
  nombre               String
  descripcion          String?
  estado               EstadoSubObra @default(ACTIVA)
  responsableCalidadId Int?
  responsableCalidad   Usuario?      @relation("SubObraResponsableCalidad", fields: [responsableCalidadId], references: [id], onDelete: SetNull)

  actividadesProgramadas ActividadProgramada[]
  avances                Avance[]
  pedidoItems            PedidoItemSubObra[]
  residentes             SubObraResidente[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sub_obras")
}

model SubObraResidente {
  id        Int     @id @default(autoincrement())
  subObraId Int
  subObra   SubObra @relation(fields: [subObraId], references: [id], onDelete: Cascade)
  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([subObraId, usuarioId])
  @@map("sub_obra_residentes")
}

model ActividadCatalogo {
  id        Int     @id @default(autoincrement())
  empresaId Int
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nombre    String
  unidad    String?

  actividadesProgramadas ActividadProgramada[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([empresaId, nombre])
  @@map("actividades_catalogo")
}

model ActividadProgramada {
  id                  Int               @id @default(autoincrement())
  subObraId           Int
  subObra             SubObra           @relation(fields: [subObraId], references: [id], onDelete: Cascade)
  actividadCatalogoId Int
  actividadCatalogo   ActividadCatalogo @relation(fields: [actividadCatalogoId], references: [id], onDelete: Restrict)
  fechaInicioPlan     DateTime?
  fechaFinPlan        DateTime?
  fechaCierreReal     DateTime?
  estado              EstadoActividad   @default(PENDIENTE)
  urgente             Boolean           @default(false)

  registrosDiarios RegistroDiario[]
  avances          Avance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("actividades_programadas")
}

model RegistroDiario {
  id                    Int                 @id @default(autoincrement())
  actividadProgramadaId Int
  actividadProgramada   ActividadProgramada @relation(fields: [actividadProgramadaId], references: [id], onDelete: Cascade)
  fecha                 DateTime
  comentario            String?
  creadoPorId           Int?
  creadoPor             Usuario?            @relation("RegistroDiarioCreadoPor", fields: [creadoPorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([actividadProgramadaId, fecha])
  @@map("registros_diarios")
}

model Avance {
  id                    Int                  @id @default(autoincrement())
  subObraId             Int
  subObra               SubObra              @relation(fields: [subObraId], references: [id], onDelete: Cascade)
  actividadProgramadaId Int?
  actividadProgramada   ActividadProgramada? @relation(fields: [actividadProgramadaId], references: [id], onDelete: SetNull)
  // dia del calendario que representa este avance (puede no ser "hoy").
  fecha                 DateTime
  titulo                String?
  descripcion           String?
  porcentaje            Int                  @default(0)
  imagenes              String[]             @default([])
  creadoPorId           Int?
  creadoPor             Usuario?             @relation("AvanceCreadoPor", fields: [creadoPorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@map("avances")
}

model MaterialCatalogo {
  id           Int     @id @default(autoincrement())
  empresaId    Int
  empresa      Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nombre       String
  unidadMedida String

  items PedidoMaterialItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([empresaId, nombre])
  @@map("materiales_catalogo")
}

model PedidoMaterial {
  id          Int          @id @default(autoincrement())
  creadoPorId Int?
  creadoPor   Usuario?     @relation("PedidoCreadoPor", fields: [creadoPorId], references: [id], onDelete: SetNull)
  fecha       DateTime     @default(now())
  urgente     Boolean      @default(false)
  estado      EstadoPedido @default(SOLICITADO)

  items PedidoMaterialItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("pedidos_material")
}

model PedidoMaterialItem {
  id                 Int              @id @default(autoincrement())
  pedidoId           Int
  pedido             PedidoMaterial   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  materialCatalogoId Int
  materialCatalogo   MaterialCatalogo @relation(fields: [materialCatalogoId], references: [id], onDelete: Restrict)
  cantidadTotal      Float

  subObras PedidoItemSubObra[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("pedido_material_items")
}

model PedidoItemSubObra {
  id                   Int                @id @default(autoincrement())
  pedidoMaterialItemId Int
  pedidoMaterialItem   PedidoMaterialItem @relation(fields: [pedidoMaterialItemId], references: [id], onDelete: Cascade)
  subObraId            Int
  subObra              SubObra            @relation(fields: [subObraId], references: [id], onDelete: Cascade)
  cantidadAsignada     Float

  @@unique([pedidoMaterialItemId, subObraId])
  @@map("pedido_item_sub_obras")
}
